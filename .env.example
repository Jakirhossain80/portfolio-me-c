# Resend API key, used by app/api/contact/route.ts to send contact-form emails.
# Get one at https://resend.com/api-keys
RESEND_API_KEY=re_your_key_here

# Canonical public origin (no path, query or fragment). Required for production
# builds, including previews; set this to the primary production domain in Vercel.
# Changing it requires a rebuild to update prerendered SEO output.
# Development alone may omit it and fall back to http://localhost:3000.
NEXT_PUBLIC_SITE_URL=https://portfolio-me-c.vercel.app
